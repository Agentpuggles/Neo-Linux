def first_of(d, *keys):
    low = {str(k).lower(): v for k, v in d.items()}
    for k in keys:
        v = low.get(k.lower())
        if v: return v
    return None

def format_news(payload):
    """News payloads vary; surface anything list-like of dicts with a title-ish field."""
    items = payload if isinstance(payload, list) else []
    if isinstance(payload, dict):
        for v in payload.values():
            if isinstance(v, list) and v and all(isinstance(i, dict) for i in v):
                items = v
                break
    out = []
    for it in items:
        if not isinstance(it, dict):
            continue
        title = first_of(it, "title", "headline", "name")
        body = first_of(it, "message", "body", "description", "content")
        date = first_of(it, "date", "publishedat", "timestamp")
        if not (title or body):
            continue
        out.append((str(date or ""), str(title or "(untitled)"), str(body or "").strip()[:200]))
    return out

# ---------------------------------------------------------------- manifest
def blob_to_bytes(s):
    return bytes(int(s[i*3:(i+1)*3]) for i in range(len(s)//3))

def parse_num(s):
    """fixed-width padded decimal blob OR plain int, little-endian."""
    if not isinstance(s, str): return int(s)
    if len(s) % 3 == 0 and s.isdigit() and len(s) >= 3:
        # ambiguous: 3-digit "031" is a plain group number, not blob of 1 byte(3=3*1 ok!)
        return int.from_bytes(blob_to_bytes(s), "little") if len(s) > 3 else int(s)
    try: return int(s)
    except ValueError: return 0

def parse_hash_hex(s):
    if not isinstance(s, str): return ""
    s = s.strip()
    if len(s) == 60 and s.isdigit(): return blob_to_bytes(s).hex()
    if s.lower().startswith("0x"): s = s[2:]
    return s.lower()

class Manifest:
    def __init__(self, d):
        self.d = d
        fl = d.get("ManifestFileVersion", "")
        flnum = int(fl[:3]) if isinstance(fl, str) and fl[:3].isdigit() else 0
        self.chunk_subdir = "ChunksV3" if flnum < 15 else "ChunksV4"
        self.chunks = {}   # guid -> {hash_u64, sha1, group, size}
        for g, v in d.get("ChunkHashList", {}).items():
            self.chunks.setdefault(g, {})["hash"] = int.from_bytes(blob_to_bytes(v), "little") \
                if (isinstance(v, str) and len(v) == 24 and v.isdigit()) else int(v or 0)
        for g, v in d.get("ChunkShaList", {}).items():
            self.chunks.setdefault(g, {})["sha1"] = parse_hash_hex(v)
        for g, v in d.get("DataGroupList", {}).items():
            self.chunks.setdefault(g, {})["group"] = int(str(v).lstrip("0") or 0)
        for g, v in d.get("ChunkFilesizeList", {}).items():
            self.chunks.setdefault(g, {})["size"] = parse_num(v)
        self.files = []
        for f in d.get("FileManifestList", []):
            parts = []
            for p in f.get("FileChunkParts", []):
                parts.append((p["Guid"], parse_num(p["Offset"]), parse_num(p["Size"])))
            self.files.append({
                "name": f["Filename"], "sha1": parse_hash_hex(f.get("FileHash", "")),
                "parts": parts,
                "exec": bool(f.get("bIsUnixExecutable")),
                "symlink": f.get("SymlinkTarget") or None,
            })

    def version(self):
        return self.d.get("BuildVersionString", "").replace("-Windows", "")

    def chunk_relpath(self, guid):
        c = self.chunks.get(guid, {})
        if self.chunk_subdir == "ChunksV4":
            return f"ChunksV4/{guid[:2]}/{guid}.chunk"
        h = c.get("hash", 0); g = c.get("group", 0) % 100
        return f"ChunksV3/{g:02d}/{h:016X}_{guid}.chunk"

def load_manifest(version, manifest_path_url):
    cache = os.path.join(cache_dir(), "manifests",
                         version.replace("/", "_") + ".json")
    if os.path.exists(cache):
        with open(cache, encoding="utf-8") as f:
            return Manifest(json.load(f))
    status, raw = http("GET", manifest_path_url, timeout=300, retries=3)
    if status != 200:
        raise RuntimeError(f"manifest download HTTP {status}")
    text = raw.decode("utf-8")
    with open(cache, "w", encoding="utf-8") as f: f.write(text)
    return Manifest(json.loads(text))

# ---------------------------------------------------------------- chunks
class Progress:
    def __init__(self, total, label, counts=False):
        self.total, self.label, self.counts = total, label, counts
        self.done = 0; self.lock = threading.Lock(); self.t0 = time.time()
        self._stop = False; self.thread = threading.Thread(target=self._run, daemon=True)
    def add(self, n):
        with self.lock: self.done += n
    def _run(self):
        while not self._stop:
            time.sleep(0.5)
            with self.lock: done = self.done
            pct = 100.0 * done / max(self.total, 1)
            rate = done / max(time.time() - self.t0, 0.001)
            eta = (self.total - done) / max(rate, 0.001)
            if self.counts:
                shown, srate, seta = f"{int(done)}/{int(self.total)}", f"{rate:.1f} files/s", f"{eta:.0f}s"
            else:
                shown, srate, seta = human(done), human(rate) + "/s", f"{eta/60:.1f}min"
            sys.stdout.write(f"\r  {self.label} {shown} ({pct:5.1f}%) {srate} ETA {seta}  ")
            sys.stdout.flush()
    def __enter__(self): self.thread.start(); return self
    def __exit__(self, *a):
        self._stop = True; self.thread.join(timeout=1)
        sys.stdout.write("\n"); sys.stdout.flush()

def parse_chunk(raw):
    if len(raw) < CHUNK_HEADER_V2: raise ValueError("chunk too small")
    magic, _ver, hsize, _dsize = struct.unpack_from("<IIII", raw, 0)
    if magic != CHUNK_MAGIC: raise ValueError("bad chunk magic")
    # layout: magic4 ver4 hsize4 dsize4 | guid16 | rollingHash8 | storedAs1 | sha1 20 | hashType1 (v2, 62B)
    stored_as = raw[40]
    sha = raw[41:61].hex()
    payload = raw[hsize:]
    data = zlib.decompress(payload) if stored_as & 1 else payload
    return data, sha

def fetch_chunk(cloud, manifest, guid, sem_stats):
    """download (or reuse cached) chunk; returns uncompressed bytes."""
    cache_file = os.path.join(cache_dir(), "chunks", guid)
    if os.path.exists(cache_file):
        with open(cache_file, "rb") as f: raw = f.read()
        try:
            data, sha = parse_chunk(raw)
            if sha == manifest.chunks.get(guid, {}).get("sha1"):
                sem_stats["reuse"] += 1
                return data
        except Exception:
            pass
    urls = [cloud + "/Builds/Fortnite/CloudDir/" + manifest.chunk_relpath(guid)]
    if manifest.chunk_subdir != "ChunksV4":
        urls.append(cloud + "/Builds/Fortnite/CloudDir/ChunksV4/"
                    f"{guid[:2]}/{guid}.chunk")
    last = None
    for url in urls:
        for attempt in range(4):
            try:
                status, raw = http("GET", url, timeout=180)
                if status == 200:
                    data, sha = parse_chunk(raw)
                    want = manifest.chunks.get(guid, {}).get("sha1")
                    if want and sha != want:
                        raise ValueError("sha1 mismatch")
                    tmp = cache_file + ".tmp"
                    with open(tmp, "wb") as f: f.write(raw)
                    os.replace(tmp, cache_file)
                    sem_stats["dl"] += 1
                    return data
                last = f"HTTP {status}"
                if status == 404 and attempt < 2:
                    time.sleep(2 * (attempt + 1))  # R2 edge can 404 transiently
                    continue
                break  # hard 404 -> try next url form
            except Exception as e:
                last = e; time.sleep(1.0 * (attempt + 1))
    raise RuntimeError(f"chunk {guid}: {last}")

# ---------------------------------------------------------------- install
def pick_build(builds, sel):
    if not sel or sel == "live":
        for b in builds:
            if b.get("isLive"): return b
        raise RuntimeError("no live build")
    for b in builds:
        if sel in b["version"]: return b
    raise RuntimeError(f"no build matches '{sel}' (try: neo list)")

def version_dir_name(version): return version

def free_space_shortages(needs):
    """[(path, free, needed)] for each (path, needed-bytes) whose volume is short.

    Engineering note 9: an install that fills the system disk mid-download is a
    bug, not a footgun — so both bulk paths are checked up front, before any
    bytes move. Unstat-able paths are left to fail later with a clearer error.
    """
    shortages = []
    for path, need in needs:
        try:
            free = shutil.disk_usage(path).free
        except OSError:
            continue
        if free < need:
            shortages.append((path, free, need))
    return shortages

def cmd_install(args, auth):
    cfg = load_config()
    builds = get_builds(auth)
    build = pick_build(builds, args.version)
    version = build["version"]
    size = build["fileSizeBytes"]
    print(f"Build: {version}  ({human(size)})")
    clouds = get_distribution_points()
    if not clouds: err("no distribution points"); sys.exit(1)
    cloud = clouds[0]
    manifest_url = cloud + "/" + build["manifestPath"].lstrip("/")
    print("Fetching manifest…")
    m = load_manifest(version, manifest_url)

    root = os.path.abspath(os.path.expanduser(args.dir or cfg["install_root"]))
    inst_dir = os.path.join(root, version_dir_name(version))
    os.makedirs(inst_dir, exist_ok=True)
    print(f"Installing to: {inst_dir}")

    needed = sorted({g for f in m.files for g, _, _ in f["parts"]})
    total = sum(m.chunks.get(g, {}).get("size", 0) for g in needed)
    print(f"{len(m.files)} files, {len(needed)} chunks ({human(total)} download worst-case)")
    total_raw = sum(size for f in m.files for _, _, size in f["parts"])
    if not getattr(args, "force", False):
        short = free_space_shortages([(cache_dir(), total), (inst_dir, total_raw)])
        for path, free, need in short:
            err(f"not enough space for {os.path.dirname(path) or path}: "
                f"{human(free)} free, {human(need)} needed")
        if short:
            err("move the cache (neo config cache_dir) or install elsewhere (-d DIR); "
                "override with --force")
            sys.exit(1)

    stats = {"dl": 0, "reuse": 0}
    chunk_cache = {}
    cache_lock = threading.Lock()
    workers = args.jobs or cfg["workers"]

    def get_chunk(guid):
        data = fetch_chunk(cloud, m, guid, stats)
        with cache_lock:
            if len(chunk_cache) > 96:
                for k in list(chunk_cache)[:32]: chunk_cache.pop(k, None)
            chunk_cache[guid] = data
        return len(data)

    with cf.ThreadPoolExecutor(max_workers=workers) as ex, Progress(total, "chunks") as pr:
        futs = {ex.submit(get_chunk, g): g for g in needed}
        for fut in cf.as_completed(futs):
            pr.add(m.chunks.get(futs[fut], {}).get("size", 0))
            fut.result()

    print(f"  chunks: {stats['dl']} downloaded, {stats['reuse']} reused from cache")
    print("Assembling files…")
    bad = []
    with Progress(len(m.files), "files", counts=True) as pr:
        for f in m.files:
            try:
                assemble_file(inst_dir, f, chunk_cache, cloud, m)
            except Exception as e:
                bad.append((f["name"], str(e)))
            pr.add(1)
    # persist manifest copy + state
    with open(os.path.join(inst_dir, ".neo-manifest.json"), "w") as fh:
        json.dump(m.d, fh)
    st = load_state()
    st["installs"][version] = {"path": inst_dir, "build": build}
    save_state(st)
    if bad:
        err(f"{len(bad)} file(s) failed:")
        for n, e in bad[:10]: print(f"    {n}: {e}")
        sys.exit(1)
    if not getattr(args, "keep_cache", False):
        purged = 0
        for g in needed:
            p = os.path.join(cache_dir(), "chunks", g)
            try: os.remove(p); purged += 1
            except OSError: pass
        print(f"  purged {purged} cached chunks (keep with --keep-cache)")
    ok(f"Installed {version} → {inst_dir}")

def install_path(inst_dir, name):
    """Resolve a manifest-supplied filename inside `inst_dir`.

    File names come off the CDN, so refuse anything that walks out of the install
    directory ("../../x", "/etc/x") instead of writing it. Symlinks inside the build
    are still honoured — they are just created at this validated destination.
    """
    root = os.path.normpath(inst_dir)
    dest = os.path.normpath(os.path.join(root, name))
    if dest != root and not dest.startswith(root + os.sep):
        raise RuntimeError(f"unsafe filename in manifest (outside {root}): {name!r}")
    return dest

def assemble_file(inst_dir, f, chunk_cache, cloud, m):
    dest = install_path(inst_dir, f["name"])
    os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
    if f["symlink"]:
        if os.path.lexists(dest): os.remove(dest)
        os.symlink(f["symlink"], dest)
        return
    h = hashlib.sha1()
    with open(dest + ".tmp", "wb") as out:
        for guid, off, size in f["parts"]:
            data = chunk_cache.get(guid)
            if data is None:
                with open(os.path.join(cache_dir(), "chunks", guid), "rb") as fh:
                    data, _ = parse_chunk(fh.read())
            out.write(data[off:off + size])
            h.update(data[off:off + size])
    if f["sha1"] and h.hexdigest() != f["sha1"]:
        os.remove(dest + ".tmp")
        raise RuntimeError(f"sha1 mismatch (want {f['sha1'][:12]}… got {h.hexdigest()[:12]}…)")
    os.replace(dest + ".tmp", dest)
    if f["exec"]: os.chmod(dest, 0o755)

def cmd_verify(args, auth):
    st = load_state()
    version, inst = select_install(args.version, st)
    print(f"Verifying {version} at {inst['path']}")
    with open(os.path.join(inst["path"], ".neo-manifest.json")) as f:
        m = Manifest(json.load(f))
    bad, missing = [], []
    with Progress(len(m.files), "files") as pr:
        for f in m.files:
            p = os.path.join(inst["path"], f["name"])
            if f["symlink"]:
                if not os.path.islink(p): missing.append(f)
            elif not os.path.exists(p):
                missing.append(f)
            else:
                h = hashlib.sha1()
                with open(p, "rb") as fh:
                    for b in iter(lambda: fh.read(1 << 20), b""): h.update(b)
                if f["sha1"] and h.hexdigest() != f["sha1"]: bad.append(f)
            pr.add(1)
    if not missing and not bad:
        ok("all files verified")
        return
    warn(f"{len(missing)} missing, {len(bad)} corrupted")
    if not getattr(args, "repair", False):
        warn(f"repair with: neo verify {version} --repair")
        return
    repair_files(inst["path"], missing + bad, m)

def repair_files(inst_path, files, m):
    """Re-fetch only the chunks the broken files need, rebuild, re-hash."""
    clouds = get_distribution_points()
    if not clouds:
        err("no distribution points — cannot repair"); sys.exit(1)
    cloud = clouds[0]
    stats = {"dl": 0, "reuse": 0}
    cache_map = {}
    fixed = failed = 0
    with Progress(len(files), "repairing", counts=True) as pr:
        for f in files:
            try:
                for guid, _off, _size in f["parts"]:
                    if guid not in cache_map:
                        cache_map[guid] = fetch_chunk(cloud, m, guid, stats)
                assemble_file(inst_path, f, cache_map, cloud, m)
                if not f["symlink"]:
                    h = hashlib.sha1()
                    with open(install_path(inst_path, f["name"]), "rb") as fh:
                        for b in iter(lambda: fh.read(1 << 20), b""): h.update(b)
                    if f["sha1"] and h.hexdigest() != f["sha1"]:
                        raise RuntimeError("sha1 still mismatched after rebuild")
                fixed += 1
            except Exception as e:
                failed += 1
                err(f"  {f['name']}: {e}")
            pr.add(1)
    print(f"  chunks: {stats['dl']} downloaded, {stats['reuse']} reused from cache")
    if failed:
        err(f"{failed} file(s) still failing"); sys.exit(1)
    ok(f"repaired {fixed} file(s)")

def cmd_import(args, auth):
    """Register a build folder that already exists on disk (no download).

    Mirrors the official client's import_neo_build: the folder must be a build
    root (contains FortniteGame/ and Engine/). The manifest is fetched so later
    `neo verify` runs have something to check against.
    """
    path = os.path.abspath(os.path.expanduser(args.path))
    for sub in ("FortniteGame", "Engine"):
        if not os.path.isdir(os.path.join(path, sub)):
            err(f"{path} does not look like a build root (no {sub}/)")
            err("pick the folder that contains FortniteGame/ and Engine/")
            sys.exit(1)
    builds = get_builds(auth)
    build = pick_build(builds, args.version)
    version = build["version"]
    clouds = get_distribution_points()
    if not clouds:
        err("no distribution points — cannot fetch the manifest"); sys.exit(1)
    m = load_manifest(version, clouds[0] + "/" + build["manifestPath"].lstrip("/"))
    with open(os.path.join(path, ".neo-manifest.json"), "w") as fh:
        json.dump(m.d, fh)
    st = load_state()
    st["installs"][version] = {"path": path, "build": build, "imported": True}
    save_state(st)
    ok(f"registered {version} → {path}")
    print(f"check it with: neo verify {version}")

def cmd_uninstall(args):
    st = load_state()
    version, inst = select_install(args.version, st)
    path = inst["path"]
    print(f"Uninstalling {version}\n  {path}")
    if os.path.isdir(path):
        # only rmtree directories that still carry our manifest — never whatever
        # a hand-edited state.json might point at
        if not os.path.exists(os.path.join(path, ".neo-manifest.json")):
            err(f"refusing: no .neo-manifest.json in {path} (not a neo install?)")
            err("dropping the state entry only; delete the folder by hand")
            st["installs"].pop(version, None)
            save_state(st)
            sys.exit(1)
        if not getattr(args, "yes", False):
            try:
                ans = input(f"type 'remove' to delete {path}: ")
            except EOFError:
                ans = ""
            if ans.strip().lower() != "remove":
                err("aborted (use --yes to skip the prompt)")
                sys.exit(1)
        shutil.rmtree(path)
    else:
        warn("install directory already gone — dropping the state entry")
    st["installs"].pop(version, None)
    save_state(st)
    ok(f"removed {version}")

def cmd_cache(args):
    action = (args.action or "stats").lower()
    cache = cache_dir()
    if action == "clear":
        subs = ["chunks", "manifests"] if getattr(args, "all", False) else ["chunks"]
        removed = freed = 0
        for sub in subs:
            d = os.path.join(cache, sub)
            for name in os.listdir(d) if os.path.isdir(d) else []:
                p = os.path.join(d, name)
                try:
                    freed += os.path.getsize(p)
                    os.remove(p)
                    removed += 1
                except OSError:
                    pass
        ok(f"removed {removed} file(s), {human(freed)} freed ({cache})")
        return
    for sub in ("chunks", "manifests"):
        d = os.path.join(cache, sub)
        n = size = 0
        if os.path.isdir(d):
            for name in os.listdir(d):
                try:
                    size += os.path.getsize(os.path.join(d, name))
                    n += 1
                except OSError:
                    pass
        print(f"{sub:<10} {n:>7} file(s)  {human(size):>10}")
    print(f"cache dir: {cache}")

def changelist_number(version):
    """Build version string -> its CL number (0 when absent), for newest-wins sorting."""
    mm = re.search(r"CL-(\d+)", version)
    return int(mm.group(1)) if mm else 0

def select_install(sel, st):
    installs = st.get("installs", {})
    if not installs: err("nothing installed yet — run: neo install"); sys.exit(1)
    if not sel or sel == "live":
        version = sorted(installs, key=changelist_number)[-1]  # newest by CL number
    else:
        version = next((v for v in installs if sel in v), None)
        if not version: err(f"no install matches '{sel}'"); sys.exit(1)
    return version, installs[version]

