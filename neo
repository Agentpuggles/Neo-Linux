def to_winpath(path, prefix=None):
    r"""Map a unix path into the prefix's Windows namespace.

    Anything inside <prefix>/drive_c becomes C:\...; everything else is reached
    through Wine's Z: drive. Paths inside the prefix must NOT be given as Z:
    paths — that is what mangled -basedir (see docs/protocol.md §8.1).
    """
    prefix = os.environ.get("WINEPREFIX") if prefix is None else prefix
    if prefix:
        dc = os.path.realpath(os.path.join(prefix, "drive_c"))
        rp = os.path.realpath(path)
        if rp == dc or rp.startswith(dc + os.sep):
            return "C:" + rp[len(dc):].replace(os.sep, "\\")
    return "Z:" + path.replace("/", "\\")

def cmd_launch(args, auth):
    st = load_state()
    _version, inst = select_install(args.version, st)
    win64 = os.path.join(inst["path"], "FortniteGame", "Binaries", "Win64")
    if not os.path.isdir(win64):
        err(f"game binaries not found: {win64}"); sys.exit(1)

    ls = lightswitch(auth)
    if ls.get("banned"): err("banned: " + str(ls.get("banReason", ""))); sys.exit(1)
    if ls.get("status") != "UP":
        warn("service status: " + str(ls.get("status")) + " — " + str(ls.get("message", "")))
    try:
        if prism_ban(auth).get("banned"):
            err("banned (prism): " + str(prism_ban(auth).get("reason", ""))); sys.exit(1)
    except Exception: pass

    # prism-patched client (mirror of PrismService: all assets -> prism dir;
    # exe is required, other assets are best-effort like the Windows launcher)
    assets = prism_assets(auth)
    prism_dir = os.path.join(data_dir(), "prism")
    exe = None
    for a in assets or []:
        dest = os.path.join(prism_dir, a["filename"])
        try:
            good = False
            if os.path.exists(dest):
                h = hashlib.sha256()
                with open(dest, "rb") as fh:
                    for b in iter(lambda: fh.read(1 << 20), b""): h.update(b)
                good = h.hexdigest().lower() == a["hash256"].lower()
            if not good:
                print(f"  prism: {a['filename']}…")
                status, raw = http("GET", a["url"], timeout=600)
                if status != 200: raise RuntimeError(f"HTTP {status}")
                if hashlib.sha256(raw).hexdigest().lower() != a["hash256"].lower():
                    raise RuntimeError("sha256 mismatch")
                with open(dest + ".tmp", "wb") as fh: fh.write(raw)
                os.replace(dest + ".tmp", dest)
            if a["filename"] == GAME_EXE_NAME: exe = dest
        except Exception as e:
            if a["filename"] == GAME_EXE_NAME:
                err(f"prism exe download failed: {e}"); sys.exit(1)
            warn(f"prism asset {a['filename']} failed ({e}) — continuing")
    if not exe:
        exe = os.path.join(prism_dir, GAME_EXE_NAME)
        if not os.path.exists(exe):
            err(f"prism did not provide {GAME_EXE_NAME}"); sys.exit(1)

    code1, exp1 = auth.exchange_code()
    code2, _exp2 = auth.exchange_code()
    if exp1: print(f"  exchange codes valid for ~{exp1}s (game must redeem before then)")
    fltoken = "".join(random.choices(string.ascii_lowercase + string.digits, k=24))

    basedir_win = to_winpath(win64)
    extra = list(args.extra or [])
    if extra and extra[0] == "--":
        extra = extra[1:]  # allow the `neo launch 10.40 -- -windowed` spelling too
    argv = [
        # bare (unquoted) basedir: through umu/wine the quotes get escaped to \"
        # and UE4's parser leaves a stray backslash, mangling the path
        "-basedir=" + basedir_win,
        "-epicapp=Fortnite", "-epicenv=Prod", "-epicportal",
        "-skippatchcheck", "-nobe", "-fromfl=eac",
        "-AUTH_LOGIN=unused", "-AUTH_TYPE=exchangecode",
        "-AUTH_PASSWORD=" + code1, "-p=" + code2, "-fltoken=" + fltoken,
        *extra,
    ]

    umu = os.environ.get("NEO_UMU", "umu-run")
    cmd = [umu] + (["--proton", args.proton] if getattr(args, "proton", None) else []) \
        + [exe] + argv
    print("Launching:", exe)
    for a in argv:
        shown = a if not a.startswith(("-AUTH_PASSWORD=", "-p=")) else a.split("=")[0] + "=***"
        print("   ", shown)
    if args.dry_run: return
    rc = subprocess.call(cmd, cwd=win64)
    print(f"\ngame exited: {rc}")

