def describe_entitlements(ent):
    """One-line summary of the store entitlements payload (§11.3).

    Field names come from the official client's DTOs, which parse
    case-insensitively; tolerate both spellings and anything unexpected.
    """
    if not isinstance(ent, dict):
        return str(ent)[:120]
    offers = ent.get("ownedOfferIds") or ent.get("owned_offer_ids") or []
    orders = ent.get("orders") or []
    subs = ent.get("subscriptions") or []
    paid = [o for o in orders if isinstance(o, dict)
            and o.get("paid") and not o.get("refunded")]
    bits = []
    if offers: bits.append("offers " + ", ".join(str(o) for o in offers))
    if orders: bits.append(f"{len(paid)}/{len(orders)} orders paid")
    if subs:   bits.append(f"{len(subs)} subscription(s)")
    return "; ".join(bits) if bits else "none on file"

