def data_dir():
    root = os.environ.get("NEO_HOME") or os.path.join(
        os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "neo")
    for sub in ("", "prism"):
        os.makedirs(os.path.join(root, sub), exist_ok=True)
    return root

def cache_dir():
    """bulk cache (chunks + manifests) — can live on another filesystem."""
    root = (os.environ.get("NEO_CACHE") or load_config().get("cache_dir")
            or os.path.join(data_dir(), "cache"))
    for sub in ("chunks", "manifests"):
        os.makedirs(os.path.join(root, sub), exist_ok=True)
    return root

def config_path():
    cfg_root = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    return os.path.join(cfg_root, "neo", "config.json")

def load_config():
    cfg = {"install_root": os.path.expanduser("~/Games/Neo"), "workers": 16}
    try:
        with open(config_path()) as f:
            cfg.update(json.load(f))
    except Exception:
        pass
    return cfg

def load_state():
    try:
        with open(os.path.join(data_dir(), "state.json")) as f:
            return json.load(f)
    except Exception:
        return {"installs": {}}

def save_state(st):
    p = os.path.join(data_dir(), "state.json")
    with open(p + ".tmp", "w") as f:
        json.dump(st, f, indent=1)
    os.replace(p + ".tmp", p)

# ---------------------------------------------------------------- console
def C(code, s): return f"\033[{code}m{s}\033[0m"
def ok(s):   print(C("32", "✔ ") + s)
def warn(s): print(C("33", "⚠ ") + s)
def err(s):  print(C("31", "✖ ") + s, file=sys.stderr)
def human(n):
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or u == "TiB": return f"{n:.1f} {u}" if u != "B" else f"{int(n)} B"
        n /= 1024

# ---------------------------------------------------------------- http
def http(method, url, body=None, headers=None, timeout=60, retries=3):
    hdrs = {"User-Agent": UA}
    if headers: hdrs.update(headers)
    data = None
    if body is not None:
        if isinstance(body, (bytes, bytearray)):
            data = bytes(body)  # pre-encoded (e.g. JSON) — caller sets Content-Type
        else:
            data = urllib.parse.urlencode(body).encode()
            hdrs.setdefault("Content-Type", "application/x-www-form-urlencoded")
    last = None
    for attempt in range(retries):
        try:
            req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.status, r.read()
        except urllib.error.HTTPError as e:
            return e.code, e.read()
        except Exception as e:
            last = e
            time.sleep(1.5 * (attempt + 1))
    raise RuntimeError(f"{method} {url} failed: {last}")

def jhttp(method, url, body=None, headers=None, timeout=60):
    status, raw = http(method, url, body, headers, timeout)
    if status >= 400:
        raise RuntimeError(f"{method} {url} -> HTTP {status}: {raw[:200].decode('utf-8','replace')}")
    return json.loads(raw or b"{}")

def basic_auth():
    import base64
    return {"Authorization": "Basic " + base64.b64encode(
        f"{CLIENT_ID}:{CLIENT_SECRET}".encode()).decode()}

# ---------------------------------------------------------------- auth
class Auth:
    def __init__(self):
        self.path = os.path.join(data_dir(), "auth.json")
        self.d = {}
        if os.path.exists(self.path):
            try:
                with open(self.path) as f: self.d = json.load(f)
            except Exception: pass

    def save(self):
        with open(self.path + ".tmp", "w") as f: json.dump(self.d, f, indent=1)
        os.replace(self.path + ".tmp", self.path)
        os.chmod(self.path, 0o600)

    @property
    def logged_in(self): return bool(self.d.get("refresh_token"))

    def _token(self, body):
        return jhttp("POST", ACCOUNT + "/api/oauth/token", body, basic_auth())

    def client_credentials(self):
        return self._token({"grant_type": "client_credentials"})

    def login_code(self, code):
        # NB: NeoFN's token endpoint wants the code in the "authorization_code"
        # field (per decompiled OAuthTokenRequest), NOT OAuth-standard "code"
        r = self._token({"grant_type": "authorization_code",
                         "authorization_code": code})
        self._store(r, kill_others=True)

    def refresh(self):
        r = self._token({"grant_type": "refresh_token",
                         "refresh_token": self.d["refresh_token"]})
        self._store(r, kill_others=False)

    def _store(self, r, kill_others):
        self.d = {
            "account_id": r["account_id"], "display_name": r.get("display_name", ""),
            "access_token": r["access_token"],
            "access_expires_at": r.get("expires_at"),
            "refresh_token": r["refresh_token"],
            "refresh_expires_at": r.get("refresh_expires_at"),
        }
        self.save()
        if kill_others:
            try: http("DELETE", ACCOUNT + "/api/oauth/sessions/kill?killType=OTHERS_ACCOUNT_CLIENT",
                      headers={"Authorization": "Bearer " + r["access_token"]})
            except Exception: pass

    def access(self):
        if not self.logged_in: err("Not logged in. Run: neo login"); sys.exit(1)
        exp = self.d.get("access_expires_at")
        if exp:
            try:
                if datetime.fromisoformat(exp.replace("Z", "+00:00")) - \
                   datetime.now(timezone.utc) < timedelta(minutes=5):
                    self.refresh()
            except Exception: pass
        return self.d["access_token"]

    def exchange_code(self):
        r = jhttp("GET", ACCOUNT + "/api/oauth/exchange",
                  headers={"Authorization": "Bearer " + self.access()})
        return r["code"], r.get("expiresInSeconds") or r.get("expires_in_seconds")

    def logout(self):
        self.d = {}
        self.save()

