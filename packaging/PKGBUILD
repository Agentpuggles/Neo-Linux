# Maintainer: Neo Linux <https://github.com/Agentpuggles/Neo-Linux>
pkgname=neo-linux
pkgver=0.6.0
pkgrel=1
pkgdesc="Native Linux desktop launcher for NeoFN, with optional CLI usage"
arch=('any')
url="https://github.com/Agentpuggles/Neo-Linux"
license=('MIT')
# The desktop app is the default entry point; CLI commands remain stdlib-only.
depends=('python' 'pyside6')
optdepends=(
  'umu-launcher: recommended way to run the game under Proton'
  'wine: alternative to umu-launcher'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/Neo-Linux-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
